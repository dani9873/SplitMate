# Copia este archivo como .env y completa los valores de tu proyecto de Supabase
# (Project Settings > API Keys). Solo valores públicos: la clave secreta nunca va en la app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Id del cliente OAuth "Aplicación web" de Google Cloud (termina en .apps.googleusercontent.com).
# Es público. Sin él, el botón de Google no aparece. Pasos en design/fase-3/google-config.md.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
