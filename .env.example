# Copia este archivo como .env y completa los valores de tu proyecto de Supabase
# (Project Settings > API Keys). Solo valores públicos: la clave secreta nunca va en la app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dominio de los enlaces de invitación (https://<dominio>/i#<token>), sin esquema ni ruta. Es público.
# Sin él, las invitaciones usan el esquema propio (splitmate://i#<token>) y el App Link no se agrega.
# En EAS va como variable de entorno del build (development y preview).
EXPO_PUBLIC_INVITE_HOST=
