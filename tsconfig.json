{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx", "nativewind-env.d.ts"],
  // Las de la base más las entradas Deno de las Edge Functions (imports npm: y el global Deno).
  // Su lógica (handler.ts) sí se revisa aquí y se prueba con Jest.
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "supabase/functions/*/index.ts"
  ]
}
