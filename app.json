{
  "expo": {
    "name": "SplitMate",
    "slug": "SplitMate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "splitmate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.dani9873.splitmate",
      "supportsTablet": true
    },
    "android": {
      "package": "com.dani9873.splitmate",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#F7F4EE"
      },
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F4EE",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0B1413"
          }
        }
      ],
      "expo-localization",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "./plugins/with-backup-rules"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b8f547af-1cf3-40bc-88dd-bad901837351"
      }
    },
    "owner": "danielescc"
  }
}
